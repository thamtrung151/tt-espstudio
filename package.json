{
  "name": "tt-espstudio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "firmware:example": "tsx scripts/export-example.ts",
    "firmware:robotics": "tsx scripts/export-robotics.ts",
    "agent:dev": "tsx server/start-agent.ts",
    "build:web": "tsc --noEmit && node scripts/build-web.mjs",
    "build:agent": "tsc --noEmit && node scripts/build-agent.mjs",
    "test:agent-browser": "playwright test --config playwright.agent.config.ts"
  },
  "dependencies": {
    "blockly": "^12.3.1",
    "fflate": "^0.8.2",
    "firebase": "13.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
